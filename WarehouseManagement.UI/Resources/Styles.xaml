<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:WarehouseManagement.UI.Converters">

    <!-- Converters -->
    <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    <conv:StringToImageConverter x:Key="StringToImage" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:DiscountPriceConverter x:Key="DiscountPriceConverter" />

    <!-- Colors -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2C3E50" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3498DB" />
    <SolidColorBrush x:Key="LightBrush" Color="#ECF0F1" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E74C3C" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#27AE60" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#BDC3C7" />

    <!-- Button base -->
    <Style TargetType="Button" x:Key="BaseButton">
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}" x:Key="PrimaryButton">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}" x:Key="DangerButton">
        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}" x:Key="SuccessButton">
        <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}" x:Key="NavButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource LightBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- TextBox -->
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="White" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="4,0" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox -->
    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
    </Style>

    <!-- ListBox -->
    <Style TargetType="ListBox">
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- DataGrid -->
    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="AlternatingRowBackground" Value="#F7F9FA" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource AppBorderBrush}" />
        <Setter Property="RowHeight" Value="32" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
        <Setter Property="ColumnHeaderHeight" Value="36" />
    </Style>

    <!-- Card panel -->
    <Style TargetType="Border" x:Key="Card">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="4" />
    </Style>

    <!-- Section header -->
    <Style TargetType="TextBlock" x:Key="SectionHeader">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- Label -->
    <Style TargetType="TextBlock" x:Key="FieldLabel">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#7F8C8D" />
        <Setter Property="Margin" Value="0,6,0,2" />
    </Style>

</ResourceDictionary>
